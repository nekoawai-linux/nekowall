[Unit]
Description=Set a wallpaper at login
Documentation=https://nekoawai.moe
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
# What happens at login is a setting, not a unit. The unit is enabled once,
# for everyone, when the package is installed; --at-login then asks
# ~/.config/nekowall/nekowall.ini what it is for. By default that is the
# first login of a system that has no wallpaper yet, and nothing after.
ExecStart=/usr/bin/nekowall --set --at-login

[Install]
WantedBy=graphical-session.target
